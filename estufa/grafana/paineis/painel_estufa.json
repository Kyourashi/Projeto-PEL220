          "datasource": {
            "type": "mysql",
            "uid": "mysql-estufa"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  recvTimeTs / 1000 AS \"time\",\n  CAST(attrValue AS DECIMAL(10,2)) AS \"temperatura\"\nFROM `urn_ngsi-ld_Device_ESP32-001_Device`\nWHERE attrName = 'temperature'\nORDER BY recvTimeTs DESC\nLIMIT 1"
        }
      ],
      "description": "Última medida do DHT22. Alface: azul abaixo de 18 °C, verde na faixa, vermelho a partir de 24 °C, quando o ventilador deve estar ligado (fanOnTemperature)."
    },
