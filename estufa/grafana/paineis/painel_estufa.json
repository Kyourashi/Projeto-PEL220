    {
      "id": 13,
      "title": "Tempo ligado em cada janela de 5 minutos",
      "type": "barchart",
      "datasource": {
        "type": "mysql",
        "uid": "mysql-estufa"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 14,
        "h": 8
      },
      "description": "Fração do tempo com o relé ligado (ciclo de trabalho), por janela de 5 min. Ventilador: energia; bomba: energia e água.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ventilador"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bomba"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "groupWidth": 0.7,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-estufa"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__unixEpochGroupAlias(recvTimeTs / 1000, '5m'),\n  100 * AVG(CASE WHEN attrName = 'fanState'  THEN attrValue = 'ON' END) AS \"ventilador\",\n  100 * AVG(CASE WHEN attrName = 'pumpState' THEN attrValue = 'ON' END) AS \"bomba\"\nFROM `urn_ngsi-ld_Device_ESP32-001_Device`\nWHERE attrName IN ('fanState', 'pumpState')\n  AND $__unixEpochFilter(recvTimeTs / 1000)\nGROUP BY 1\nORDER BY 1"
        }
      ]
    },
