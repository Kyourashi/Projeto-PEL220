          "datasource": {
            "type": "mysql",
            "uid": "mysql-estufa"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  SUM(attrName = 'fanState')  AS \"ventilador\",\n  SUM(attrName = 'pumpState') AS \"bomba\"\nFROM (\n  SELECT attrName, attrValue,\n         LAG(attrValue) OVER (PARTITION BY attrName ORDER BY recvTimeTs) AS anterior\n  FROM `urn_ngsi-ld_Device_ESP32-001_Device`\n  WHERE attrName IN ('fanState', 'pumpState')\n    AND $__unixEpochFilter(recvTimeTs / 1000)\n) AS mudancas\nWHERE attrValue = 'ON' AND anterior = 'OFF'"
        }
      ],
      "description": "Quantas vezes cada relé passou de OFF para ON: desgaste do relé e picos de partida do motor."
