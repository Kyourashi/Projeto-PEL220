          "rawSql": "SELECT\n  recvTimeTs / 1000 AS \"time\",\n  CAST(attrValue AS DECIMAL(6,1)) AS \"temperatura\"\nFROM `urn_ngsi-ld_Device_ESP32-001_Device`\nWHERE attrName = 'temperature'\n  AND $__unixEpochFilter(recvTimeTs / 1000)\nORDER BY recvTimeTs ASC"
        }
