            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 14
              },
              {
                "color": "orange",
                "value": 18
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^DLI$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-estufa"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  AVG(CAST(attrValue AS DECIMAL(10,1))) * 0.0185 * 86400 / 1000000 AS \"DLI\"\nFROM `urn_ngsi-ld_Device_ESP32-001_Device`\nWHERE attrName = 'illuminance'\n  AND $__unixEpochFilter(recvTimeTs / 1000)"
        }
      ],
      "description": "Luz diária integrada das últimas 24 h: média da iluminância × 0,0185 (lx → µmol/m²/s, luz do sol) × 86 400 s ÷ 10⁶. Alface: 14 a 18 mol/m²/dia (verde).",
      "timeFrom": "24h",
      "hideTimeOverride": true
    },
