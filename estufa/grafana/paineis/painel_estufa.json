          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  100 * AVG(CASE WHEN attrName = 'fanState'  THEN attrValue = 'ON' END) AS \"ventilador\",\n  100 * AVG(CASE WHEN attrName = 'pumpState' THEN attrValue = 'ON' END) AS \"bomba\"\nFROM `urn_ngsi-ld_Device_ESP32-001_Device`\nWHERE attrName IN ('fanState', 'pumpState')\n  AND $__unixEpochFilter(recvTimeTs / 1000)"
        }
      ],
      "description": "Ciclo de trabalho no período do seletor: média das amostras ligadas (uma a cada 5 s)."
    },
    {
      "id": 15,
      "title": "Acionamentos no período",
      "type": "stat",
      "datasource": {
        "type": "mysql",
        "uid": "mysql-estufa"
      },
      "gridPos": {
        "x": 19,
        "y": 22,
        "w": 5,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-estufa"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  SUM(attrName = 'fanState')  AS \"ventilador\",\n  SUM(attrName = 'pumpState') AS \"bomba\"\nFROM (\n  SELECT attrName, attrValue,\n         LAG(attrValue) OVER (PARTITION BY attrName ORDER BY recvTimeTs) AS anterior\n  FROM `urn_ngsi-ld_Device_ESP32-001_Device`\n  WHERE attrName IN ('fanState', 'pumpState')\n    AND $__unixEpochFilter(recvTimeTs / 1000)\n) AS mudancas\nWHERE attrValue = 'ON' AND anterior = 'OFF'"
        }
      ],
      "description": "Quantas vezes cada relé passou de OFF para ON: desgaste do relé e picos de partida do motor."
    }
  ]
