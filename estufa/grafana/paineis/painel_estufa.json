    {
      "id": 2,
      "title": "Temperatura",
      "type": "stat",
      "datasource": {
        "type": "mysql",
        "uid": "mysql-estufa"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 18
              },
              {
                "color": "red",
                "value": 24
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-estufa"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  recvTimeTs / 1000 AS \"time\",\n  CAST(attrValue AS DECIMAL(10,2)) AS \"temperatura\"\nFROM `urn_ngsi-ld_Device_ESP32-001_Device`\nWHERE attrName = 'temperature'\nORDER BY recvTimeTs DESC\nLIMIT 1"
        }
      ],
      "description": "Última medida do DHT22. Alface: azul abaixo de 18 °C, verde na faixa, vermelho a partir de 24 °C, quando o ventilador deve estar ligado (fanOnTemperature)."
    },
