          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  recvTimeTs / 1000 AS \"time\",\n  CAST(attrValue AS DECIMAL(10,2)) AS \"VPD\"\nFROM `urn_ngsi-ld_Device_ESP32-001_Device`\nWHERE attrName = 'vaporPressureDeficit'\nORDER BY recvTimeTs DESC\nLIMIT 1"
        }
