    {
      "id": 11,
      "title": "Temperatura do ar dentro e lá fora, e os limites do ventilador (22 °C e 24 °C)",
      "type": "timeseries",
      "datasource": {
        "type": "mysql",
        "uid": "mysql-estufa"
      },
      "description": "Dentro (DHT22): a curva deve oscilar entre as linhas; o ventilador liga ao cruzar 24 °C e desliga ao cruzar 22 °C. Lá fora (clima-externo, uma leitura a cada 15 min, em degraus): na estufa real, o ventilador só resfria até perto dela; com lá fora acima de 22 °C, ele não consegue desligar. A simulação não usa o clima de fora.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "transparent",
                "value": 18
              },
              {
                "color": "green",
                "value": 22
              },
              {
                "color": "red",
                "value": 24
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed+area"
            },
            "axisSoftMin": 15,
            "axisSoftMax": 30
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "lá fora"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              },
              {
                "id": "custom.lineInterpolation",
                "value": "stepAfter"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-estufa"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  recvTimeTs / 1000 AS \"time\",\n  CAST(attrValue AS DECIMAL(6,1)) AS \"dentro\"\nFROM `urn_ngsi-ld_Device_ESP32-001_Device`\nWHERE attrName = 'temperature'\n  AND $__unixEpochFilter(recvTimeTs / 1000)\nORDER BY recvTimeTs ASC"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-estufa"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT t_s AS \"time\", externa AS \"lá fora\"\nFROM (\n  (SELECT recvTimeTs / 1000 AS t_s, CAST(attrValue AS DECIMAL(6,1)) AS externa\n   FROM `urn_ngsi-ld_WeatherObserved_FEI_WeatherObserved`\n   WHERE attrName = 'temperature' AND recvTimeTs < $__unixEpochFrom() * 1000\n   ORDER BY recvTimeTs DESC LIMIT 1)\n  UNION ALL\n  (SELECT recvTimeTs / 1000, CAST(attrValue AS DECIMAL(6,1))\n   FROM `urn_ngsi-ld_WeatherObserved_FEI_WeatherObserved`\n   WHERE attrName = 'temperature' AND $__unixEpochFilter(recvTimeTs / 1000))\n  UNION ALL\n  (SELECT $__unixEpochTo(), CAST(attrValue AS DECIMAL(6,1))\n   FROM `urn_ngsi-ld_WeatherObserved_FEI_WeatherObserved`\n   WHERE attrName = 'temperature' AND recvTimeTs <= $__unixEpochTo() * 1000\n   ORDER BY recvTimeTs DESC LIMIT 1)\n) AS leituras\nORDER BY t_s"
        }
      ]
    },
